{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "agy": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgyConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "data_dir": {
      "type": "string"
    },
    "delivery_dir": {
      "type": "string"
    },
    "integration_ref": {
      "type": "string"
    },
    "lease_seconds": {
      "type": "integer",
      "format": "int64"
    },
    "llama_cpp": {
      "anyOf": [
        {
          "$ref": "#/$defs/LlamaCppConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_attempts": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "max_workers": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "opencode_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy": {
      "$ref": "#/$defs/ModelPolicy"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Profile"
      }
    },
    "project_id": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "verifier_executable": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "project_id",
    "repository",
    "data_dir",
    "delivery_dir",
    "integration_ref",
    "profiles",
    "policy",
    "max_workers",
    "lease_seconds",
    "max_attempts"
  ],
  "$defs": {
    "AgyConfig": {
      "type": "object",
      "properties": {
        "adapter_commit": {
          "type": "string"
        },
        "adapter_repository": {
          "type": "string"
        },
        "executable": {
          "type": "string"
        },
        "expected_tool_permission": {
          "type": "string"
        },
        "home": {
          "type": "string"
        },
        "included_quota_approved": {
          "description": "Operator policy approval, NOT a measured cost or automatic quota attestation.",
          "type": "boolean"
        },
        "model": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "workflow": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "executable",
        "home",
        "adapter_repository",
        "adapter_commit",
        "model",
        "workflow",
        "timeout_seconds",
        "expected_tool_permission",
        "included_quota_approved"
      ]
    },
    "Check": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "result_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultContract"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "argv"
      ]
    },
    "LlamaCppConfig": {
      "type": "object",
      "properties": {
        "context_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "endpoint": {
          "type": "string"
        },
        "max_transcript_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "max_turns": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "model": {
          "description": "Exact alias advertised by the existing local server, not a model path.",
          "type": "string"
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "request_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "endpoint",
        "model",
        "context_tokens",
        "output_tokens",
        "request_timeout_seconds",
        "max_turns",
        "max_transcript_bytes"
      ]
    },
    "ModelPolicy": {
      "type": "object",
      "properties": {
        "cooldown_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "data_approved": {
          "type": "boolean"
        },
        "free_only": {
          "type": "boolean"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spend_ceiling": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "models",
        "free_only",
        "spend_ceiling",
        "data_approved",
        "cooldown_seconds"
      ]
    },
    "Profile": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Check"
          }
        },
        "id": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "checks",
        "timeout_seconds"
      ]
    },
    "ResultContract": {
      "type": "object",
      "properties": {
        "evidence_type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "evidence_type"
      ]
    }
  }
}
