{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "verifying",
        "blocked",
        "retry_wait",
        "paused",
        "done"
      ]
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "current_attempt": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "attempt_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "lease_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "lease_expires_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "repository_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "approved_base_commit": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "worktree_binding": {
              "type": "string",
              "minLength": 1
            },
            "task_brief": {
              "type": "string",
              "maxLength": 8000
            },
            "acceptance_criteria": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "protected_paths": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "allowed_verification_profiles": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "max_attempts": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "timeout_seconds": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "max_attempts",
                "timeout_seconds"
              ],
              "additionalProperties": false
            },
            "policy_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "job_id",
            "attempt_id",
            "lease_id",
            "session_id",
            "lease_expires_at",
            "repository_id",
            "approved_base_commit",
            "worktree_binding",
            "task_brief",
            "acceptance_criteria",
            "protected_paths",
            "allowed_verification_profiles",
            "limits",
            "policy_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "permitted_next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "factory_status",
          "factory_next_task",
          "factory_request_verification",
          "factory_submit_candidate"
        ]
      }
    },
    "blockers": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "active_verification_receipt": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "verification_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "candidate_commit": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "verification_profile_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "profile_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "environment_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "outcome": {
              "type": "string",
              "enum": [
                "passed",
                "failed"
              ]
            },
            "commands": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "exit_status": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "command",
                  "exit_status"
                ],
                "additionalProperties": false
              }
            },
            "artifacts": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "reference",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "verification_id",
            "candidate_commit",
            "verification_profile_id",
            "profile_version",
            "environment_id",
            "outcome",
            "commands",
            "artifacts"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "delivery_reference": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "next_retry_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "state",
    "state_revision",
    "current_attempt",
    "permitted_next_actions",
    "blockers",
    "active_verification_receipt",
    "delivery_reference",
    "freshness_timestamp",
    "next_retry_at",
    "outcome"
  ],
  "additionalProperties": false
}
