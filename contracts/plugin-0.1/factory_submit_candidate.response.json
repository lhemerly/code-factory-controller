{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "accepted_for_integration",
        "needs_rework",
        "blocked"
      ]
    },
    "reasons": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "status",
    "reasons",
    "state_revision"
  ],
  "additionalProperties": false
}
