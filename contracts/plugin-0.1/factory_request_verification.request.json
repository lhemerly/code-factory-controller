{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "lease_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "verification_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "protocol_version": {
      "type": "string",
      "const": "0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "job_id",
    "attempt_id",
    "lease_id",
    "candidate_commit",
    "verification_profile_id",
    "idempotency_key",
    "protocol_version",
    "request_id",
    "project_id",
    "session_id"
  ],
  "additionalProperties": false
}
