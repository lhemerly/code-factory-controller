{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "no_task"
        },
        "retry_after": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "assignment"
        },
        "assignment": {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "attempt_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "lease_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "lease_expires_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "repository_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "approved_base_commit": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "worktree_binding": {
              "type": "string",
              "minLength": 1
            },
            "task_brief": {
              "type": "string",
              "maxLength": 8000
            },
            "acceptance_criteria": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "protected_paths": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "allowed_verification_profiles": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "max_attempts": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "timeout_seconds": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "max_attempts",
                "timeout_seconds"
              ],
              "additionalProperties": false
            },
            "policy_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "job_id",
            "attempt_id",
            "lease_id",
            "session_id",
            "lease_expires_at",
            "repository_id",
            "approved_base_commit",
            "worktree_binding",
            "task_brief",
            "acceptance_criteria",
            "protected_paths",
            "allowed_verification_profiles",
            "limits",
            "policy_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "assignment"
      ],
      "additionalProperties": false
    }
  ]
}
