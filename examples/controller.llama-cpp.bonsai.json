{
  "project_id": "example-project",
  "repository": "/absolute/path/approved-repository",
  "data_dir": "/absolute/path/controller-data",
  "delivery_dir": "/absolute/path/deliveries",
  "integration_ref": "refs/heads/factory-integration",
  "profiles": [
    {
      "id": "application-checks",
      "version": "1",
      "timeout_seconds": 300,
      "checks": [
        {
          "id": "dependencies",
          "argv": [
            "npm",
            "ci",
            "--no-audit",
            "--no-fund"
          ]
        },
        {
          "id": "unit-tests",
          "argv": [
            "npm",
            "test"
          ]
        },
        {
          "id": "type-checks",
          "argv": [
            "npm",
            "run",
            "check"
          ]
        }
      ]
    }
  ],
  "policy": {
    "models": [
      "llama_cpp/bonsai-heretic-v2-27b-ptq1_0"
    ],
    "free_only": true,
    "spend_ceiling": 0,
    "data_approved": true,
    "cooldown_seconds": 60
  },
  "max_workers": 1,
  "lease_seconds": 1800,
  "max_attempts": 3,
  "opencode_url": null,
  "llama_cpp": {
    "endpoint": "http://127.0.0.1:8080/v1",
    "model": "bonsai-heretic-v2-27b-ptq1_0",
    "context_tokens": 8192,
    "output_tokens": 1024,
    "request_timeout_seconds": 120,
    "max_turns": 32,
    "max_transcript_bytes": 32768
  }
}
