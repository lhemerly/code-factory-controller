#!/bin/sh
# Source-checkout native CLI bootstrap; production releases install the binary directly.
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
source_root=$(dirname -- "$script_dir")
# Reconcile the artifact with the selected checkout on every source invocation.
# Cargo reuses its cache when the source is unchanged.
cargo build --locked --release --manifest-path "$source_root/Cargo.toml" --target-dir "$source_root/target"
exec "$source_root/target/release/code-factory-controller" "$@"
